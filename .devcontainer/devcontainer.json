{
  "name": "Chishiki Dev",

  // ── Compose-based setup: devcontainer + all infrastructure services ──────
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",

  // ── Additional tooling installed on top of the base image ────────────────
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/powershell:1": { "version": "latest" },
    "ghcr.io/devcontainers/features/github-cli:1": { "version": "latest" }
  },

  // ── Post-create: restore packages, install dev tools, configure shell ────
  "postCreateCommand": "bash /workspace/.devcontainer/postCreate.sh",

  // ── Env vars injected into every terminal and launch config ──────────────
  "remoteEnv": {
    "ASPNETCORE_ENVIRONMENT": "Development",
    "DOTNET_ENVIRONMENT": "Development",
    "ConnectionStrings__redis": "redis:6379",
    "ConnectionStrings__postgresql": "Host=postgresql;Port=5432;Database=chishiki;Username=chishiki;Password=chishiki",
    "ASPIRE_ALLOW_UNSECURED_TRANSPORT": "true",
    "DOTNET_DASHBOARD_OTLP_ENDPOINT_URL": "http://localhost:18889",
    "DOTNET_RESOURCE_SERVICE_ENDPOINT_URL": "http://localhost:20000"
  },

  // ── Port forwarding ───────────────────────────────────────────────────────
  "forwardPorts": [
    15888,
    8080,
    8180,
    5432,
    6379,
    9090,
    3000,
    6333,
    6334,
    11434,
    11111,
    30000
  ],
  "portsAttributes": {
    "15888": { "label": "Aspire Dashboard",   "onAutoForward": "openBrowser" },
    "8080":  { "label": "API Web",             "onAutoForward": "notify" },
    "8180":  { "label": "Keycloak",            "onAutoForward": "notify" },
    "3000":  { "label": "Grafana",             "onAutoForward": "notify" },
    "9090":  { "label": "Prometheus",          "onAutoForward": "silent" },
    "5432":  { "label": "PostgreSQL",          "onAutoForward": "silent" },
    "6379":  { "label": "Redis",               "onAutoForward": "silent" },
    "6333":  { "label": "Qdrant HTTP",         "onAutoForward": "silent" },
    "6334":  { "label": "Qdrant gRPC",         "onAutoForward": "silent" },
    "11434": { "label": "Ollama",              "onAutoForward": "silent" },
    "11111": { "label": "Orleans Silo",        "onAutoForward": "silent" },
    "30000": { "label": "Orleans Gateway",     "onAutoForward": "silent" }
  },

  // ── VS Code extensions and settings ──────────────────────────────────────
  "customizations": {
    "vscode": {
      "extensions": [
        // C# / .NET — full Visual Studio-like project system, IntelliSense, debugger, test explorer
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.vscode-dotnet-runtime",

        // Containers / Docker
        "ms-azuretools.vscode-docker",

        // GitHub Copilot
        "github.copilot",
        "github.copilot-chat",

        // Git
        "eamodio.gitlens",
        "github.vscode-github-actions",

        // Code quality
        "editorconfig.editorconfig",
        "usernamehw.errorlens",
        "streetsidesoftware.code-spell-checker",
        "aaron-bond.better-comments",

        // Shells & scripts
        "ms-vscode.powershell",
        "timonwong.shellcheck",
        "foxundermoon.shell-format",

        // File-format support
        "redhat.vscode-yaml",
        "redhat.vscode-xml",
        "humao.rest-client",

        // Icons / UI
        "PKief.material-icon-theme"
      ],
      "settings": {
        "dotnet.defaultSolution": "Chishiki.slnx",
        "editor.formatOnSave": true,
        "editor.rulers": [120],
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "[csharp]": {
          "editor.defaultFormatter": "ms-dotnettools.csdevkit"
        },
        "[json]": {
          "editor.defaultFormatter": "vscode.json-language-features"
        },
        "[yaml]": {
          "editor.defaultFormatter": "redhat.vscode-yaml"
        },
        "[dockerfile]": {
          "editor.defaultFormatter": "ms-azuretools.vscode-docker"
        },
        "files.watcherExclude": {
          "**/node_modules/**": true,
          "**/.git/objects/**": true,
          "**/bin/**": true,
          "**/obj/**": true
        },
        "terminal.integrated.defaultProfile.linux": "bash",
        "docker.dockerodeOptions": {
          "socketPath": "/var/run/docker.sock"
        },
        "errorLens.enabledDiagnosticLevels": ["error", "warning"],
        "cSpell.words": [
          "Chishiki", "Orleans", "Aspire", "Keycloak",
          "Qdrant", "Ollama", "pgvector", "ohmyposh"
        ]
      }
    }
  }
}
