# ============================================================
#  Chishiki — .NET 10 / Orleans / Docker / Azure
#  .gitignore — Professional Solution Ignores
# ============================================================

# ────────────────────────────────────────────────────────────
#  Build Artifacts
# ────────────────────────────────────────────────────────────
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/
!logs/.gitkeep

# ────────────────────────────────────────────────────────────
#  Visual Studio
# ────────────────────────────────────────────────────────────
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
.idea/
*.rsuser
*.DotSettings.user
# VS Test Results
TestResults/
*.trx
*.coverage
*.coveragexml
# VS Publish profiles (keep tracked profiles, ignore overrides)
PublishProfiles/
**/Properties/PublishProfiles/*.pubxml.user

# ────────────────────────────────────────────────────────────
#  NuGet
# ────────────────────────────────────────────────────────────
*.nupkg
*.snupkg
**/[Pp]ackages/
nuget.config.local
project.lock.json
project.fragment.lock.json
artifacts/

# ────────────────────────────────────────────────────────────
#  .NET / MSBuild
# ────────────────────────────────────────────────────────────
project.assets.json
*.msbuildcache
.dotnet/
global.json.local

# ────────────────────────────────────────────────────────────
#  .NET Aspire — Dashboard tokens & run-time state
# ────────────────────────────────────────────────────────────
.aspire/
aspire-manifest.json
**/aspireconfiguration/

# ────────────────────────────────────────────────────────────
#  Docker & Containers
# ────────────────────────────────────────────────────────────
docker-compose.override.yml
docker-compose.*.override.yml
.docker/
containers/**/data/
containers/**/logs/
# Keep config files, ignore runtime data
!containers/**/*.conf
!containers/**/*.yaml
!containers/**/*.yml
!containers/**/*.json
!containers/**/Dockerfile

# ────────────────────────────────────────────────────────────
#  Secrets & Environment
# ────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.template
appsettings.local.json
appsettings.secrets.json
appsettings.*.local.json
secrets.json
**/*secrets*.json
**/*secret*.yml
**/local.settings.json
launchSettings.json.user

# ────────────────────────────────────────────────────────────
#  Certificates & Keys
# ────────────────────────────────────────────────────────────
*.pfx
*.p12
*.pem
*.key
*.crt
*.cer
!containers/keycloak/**/*.pem

# ────────────────────────────────────────────────────────────
#  Copilot Session Logs (generated by hooks)
# ────────────────────────────────────────────────────────────
logs/copilot/

# ────────────────────────────────────────────────────────────
#  Kubernetes / Helm
# ────────────────────────────────────────────────────────────
infrastructure/helm/**/charts/*.tgz
infrastructure/helm/*/values.local.yaml
kubeconfig
*.kubeconfig

# ────────────────────────────────────────────────────────────
#  Terraform / Bicep
# ────────────────────────────────────────────────────────────
**/.terraform/
**/.terraform.lock.hcl
**/terraform.tfstate
**/terraform.tfstate.backup
**/terraform.tfvars
!**/terraform.tfvars.example
**/crash.log
**/override.tf
**/override.tf.json
**/*_override.tf
**/*_override.tf.json

# ────────────────────────────────────────────────────────────
#  OS Artifacts
# ────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ────────────────────────────────────────────────────────────
#  Node / npm (for tooling only)
# ────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ────────────────────────────────────────────────────────────
#  Python / uv (for MCP uvx tools)
# ────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
.uv/

# ────────────────────────────────────────────────────────────
#  JetBrains Rider
# ────────────────────────────────────────────────────────────
.idea/
*.sln.iml

# ────────────────────────────────────────────────────────────
#  Coverage & Test Artifacts
# ────────────────────────────────────────────────────────────
coverage/
*.opencover.xml
*.cobertura.xml
BenchmarkDotNet.Artifacts/

# ────────────────────────────────────────────────────────────
#  Grafana / Prometheus runtime state
# ────────────────────────────────────────────────────────────
containers/grafana/data/
containers/prometheus/data/
containers/qdrant/storage/
containers/ollama/models/

# ────────────────────────────────────────────────────────────
#  Misc
# ────────────────────────────────────────────────────────────
*.bak
*.tmp
*.temp
*.orig
*.patch
*.rej
.cache/

/.crew/
/.crew
!.crew/artifacts/
!.crew/graphs/
!.crew/artifacts/.gitkeep
!.crew/graphs/.gitkeep