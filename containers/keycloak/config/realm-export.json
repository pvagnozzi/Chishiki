{
  "realm": "chishiki",
  "enabled": true,
  "displayName": "Chishiki",
  "displayNameHtml": "<strong>Chishiki</strong>",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "loginTheme": "chishiki-login",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "clients": [
    {
      "clientId": "chishiki-api",
      "name": "Chishiki API",
      "description": "Chishiki API OIDC Client",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "chishiki-api-secret-change-in-production",
      "redirectUris": [
        "http://localhost:*",
        "https://localhost:*",
        "http://chishiki-api-web:8080/*"
      ],
      "webOrigins": ["+"],
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["web-origins", "profile", "roles", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access"]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrator role"
      },
      {
        "name": "user",
        "description": "Standard user role"
      }
    ]
  },
  "users": [
    {
      "username": "admin",
      "email": "admin@chishiki.local",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": ["admin", "user"]
    }
  ]
}
