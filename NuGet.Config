<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="daikinapplied.eu" value="https://pkgs.dev.azure.com/daikinappliedeurope/_packaging/daikinappliedeurope/nuget/v3/index.json" protocolVersion="3" />
    <!-- Microsoft Visual Studio offline packages -->
    <add key="Microsoft Visual Studio Offline Packages" value="C:\Program Files (x86)\Microsoft SDKs\NuGetPackages\" />
  </packageSources>

  <!--
    Package Source Mapping — richiesto quando ManagePackageVersionsCentrally=true
    e sono configurate più origini NuGet. Mappa ogni pacchetto all'origine corretta.
  -->
  <packageSourceMapping>
    <!-- Feed Daikin (pacchetti interni aziendali) -->
    <packageSource key="daikinapplied.eu">
      <package pattern="Daikin.*" />
    </packageSource>

    <!-- Microsoft Visual Studio offline packages -->
    <packageSource key="Microsoft Visual Studio Offline Packages">
      <package pattern="Microsoft.VisualStudio.*" />
    </packageSource>

    <!-- Tutti gli altri pacchetti da nuget.org -->
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
